# Environment secrets — NEVER push real keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# IDE / OS
.idea/
.DS_Store
Thumbs.db

# Sensitive local files
KMS/

# Claude Code
.claude/settings.local.json
.claude/worktrees/

# OpenAI Codex
.codex/config.local.toml

# Gemini CLI
.gemini/history/
.gemini/tmp/
.gemini/google_accounts.json
.gemini/installation_id
.gemini/oauth_creds.json

# Cursor
.cursor/chat/
.cursor/rules/*.local.mdc

# GitHub CLI
.github/personal-instructions.md

# SQLite database — auto-created on first run by initialize_db()
# Excluded to avoid pushing real user data to GitHub.
# The database is created automatically when the app starts.
*.db
*.sqlite
*.sqlite3
